<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:padding="12dp"
    android:layout_margin="8dp">

    <!-- Nombre del Ejercicio -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/exercise_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Flexiones"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/accent" />

        <TextView
            android:id="@+id/difficulty_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/5"
            android:textSize="10sp"
            android:textColor="@color/text_primary"
            android:background="@color/primary"
            android:padding="4dp" />

    </LinearLayout>

    <!-- Variante -->
    <TextView
        android:id="@+id/exercise_variant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Flexiones Estándar"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="8dp" />

    <!-- Series y Repeticiones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Series"
                android:textSize="10sp"
                android:textColor="@color/text_tertiary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btn_decrease_sets"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="-"
                    android:textColor="@color/text_primary"
                    android:background="@color/primary"
                    android:padding="0dp" />

                <TextView
                    android:id="@+id/sets_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="3"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:gravity="center" />

                <Button
                    android:id="@+id/btn_increase_sets"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="+"
                    android:textColor="@color/text_primary"
                    android:background="@color/primary"
                    android:padding="0dp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Repeticiones"
                android:textSize="10sp"
                android:textColor="@color/text_tertiary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btn_decrease_reps"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="-"
                    android:textColor="@color/text_primary"
                    android:background="@color/primary"
                    android:padding="0dp" />

                <TextView
                    android:id="@+id/reps_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="15"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:gravity="center" />

                <Button
                    android:id="@+id/btn_increase_reps"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="+"
                    android:textColor="@color/text_primary"
                    android:background="@color/primary"
                    android:padding="0dp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descanso (s)"
                android:textSize="10sp"
                android:textColor="@color/text_tertiary" />

            <TextView
                android:id="@+id/rest_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="60"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

    <!-- Checkbox de Completado -->
    <CheckBox
        android:id="@+id/exercise_completed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio Completado"
        android:textColor="@color/text_secondary"
        android:buttonTint="@color/accent" />

</LinearLayout>

